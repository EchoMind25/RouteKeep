# Copy to .env.local for development. Production values live in Netlify and
# GitHub Actions secrets only (PRD section 18). Never commit real values.

# "supabase" in every hosted environment. "local" = development sign-in without
# Supabase; refused unless DATABASE_URL points at this machine and the process
# is not a Netlify deploy.
AUTH_MODE=supabase
APP_URL=http://localhost:3000

# Postgres connection used by the server (withRls / withServiceRole).
# Supabase: the transaction pooler URL (port 6543), ideally as the restricted
# routekeep_app role (docs/DEPLOY.md). Local: scripts/db/local.sh prints it.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for AUTH_MODE=local (32+ random characters).
LOCAL_AUTH_SECRET=

# Later milestones (unused until then).
POWERSYNC_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Without a key, addresses are placed on the map by hand (nothing is sent to Google).
GOOGLE_MAPS_API_KEY=
ROUTE_OPTIMIZER=google
SENTRY_DSN=
