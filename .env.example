# Copy to .env.local for development. Production values live in Netlify and
# GitHub Actions secrets only (PRD section 18). Never commit real values.

# "supabase" in every hosted environment. "local" = development sign-in without
# Supabase; refused unless DATABASE_URL points at this machine and the process
# is not a Netlify deploy.
AUTH_MODE=supabase
APP_URL=http://localhost:3000

# Postgres connection used by the server (withRls / withServiceRole).
# Supabase: the transaction pooler URL (port 6543), ideally as the restricted
# routekeep_app role (docs/DEPLOY.md). Local: scripts/db/local.sh prints it.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for AUTH_MODE=local (32+ random characters).
LOCAL_AUTH_SECRET=

# Photos, signatures and records (FR-TEC-09). "supabase" (a private bucket, needs
# SUPABASE_SERVICE_ROLE_KEY) or "local" (files under LOCAL_STORAGE_DIR; refused
# unless the database is on this machine). Empty: local when AUTH_MODE=local.
STORAGE_PROVIDER=
STORAGE_BUCKET=attachments
LOCAL_STORAGE_DIR=.local/storage

# Later milestones (unused until then).
POWERSYNC_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Without a key, addresses are placed on the map by hand (nothing is sent to Google).
GOOGLE_MAPS_API_KEY=
# D-07. "estimate" orders routes on this server from straight-line distances
# and sends nothing anywhere. The google and vroom adapters are not built yet.
ROUTE_OPTIMIZER=estimate
# D-07: the AI route planner. Leave the key empty to hide the AI plan button.
# Set a monthly spend limit on the key in the Anthropic console.
ANTHROPIC_API_KEY=
ROUTE_AI_MODEL=claude-fable-5-1
ROUTE_AI_EFFORT=high
ROUTE_AI_STEP_MS=15000
SENTRY_DSN=

# Street map behind the dispatch board and the pin check (D-08). Empty means no
# basemap: pins and routes on a plain background and no tile requests at all,
# which makes pin checks much harder. Any MapLibre style URL works. Whoever
# hosts the tiles sees each viewer's IP address and which map areas they look
# at (docs/VENDORS.md). Chosen: OpenFreeMap, free and keyless (verify on openfreemap.org):
#   https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=

# Public landing page. The site's address (canonical links, sitemap, social
# cards); defaults to the Netlify address until the domain is live.
NEXT_PUBLIC_SITE_URL=
# Where "Ask about white label" sends people. Empty sends them to sign up.
NEXT_PUBLIC_SALES_EMAIL=RouteKeep@proton.me

# M6: portal sessions and unsubscribe links (32+ random characters).
APP_SECRET=
# Email: "resend" in production; "log" writes emails to LOCAL_MAIL_DIR (development only).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
# For a scheduler other than Inngest: POST /api/cron?job=outbox|reminders|billing
CRON_SECRET=
